# Copy to .env and fill in. Never commit .env.

# Required in production: strong random secret for JWT signing (e.g. openssl rand -hex 32)
JWT_SECRET=***

# Required for internal alerts evaluator endpoint (/internal/alerts/evaluate-now)
# Legacy static key header: x-internal-key
ALERTS_INTERNAL_KEY=***

# Recommended: HMAC signing secret for internal evaluator requests.
# Client must send:
# - x-internal-timestamp: unix ms
# - x-internal-signature: HMAC-SHA256("<timestamp>.<METHOD>.<PATH>.<contentSha256>")
# - x-internal-content-sha256: optional body SHA256 hex
# ALERTS_INTERNAL_HMAC_SECRET=***

# API server port
PORT=3001

# Production (Railway, etc.): required for SIWE sign-in and CORS. Exact app URL, no trailing slash.
# WEB_ORIGIN=https://yourapp.up.railway.app

# Optional: explicit CORS allowlist (comma-separated origins, no path), merged with WEB_ORIGIN/ELECTRON_ORIGIN/VITE_API_URL values.
# CORS_ALLOWED_ORIGINS=https://app.yoursite.com,https://dashboard.yoursite.com

# Optional: allow Origin: null requests in production (default false in prod, true in dev)
# ALLOW_NULL_ORIGIN=false

# Optional: disable cookie-auth write Origin/Referer guard (not recommended)
# DISABLE_CSRF_ORIGIN_CHECK=false

# CSP report-only controls for staged rollout
# ENABLE_CSP_REPORT_ONLY=true
# CSP_REPORT_URI=/internal/csp-report
# LOG_CSP_REPORTS=false

# Production: MongoDB Atlas connection string (for activity + transaction logs). Server starts without it (file fallback for activity; 503 for transactions).
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# Production behind a proxy (e.g. Railway): set so req.ip and rate limits use the real client IP.
# TRUST_PROXY=1

# Production: API base URL for the frontend (used at build time: npm run build)
# VITE_API_URL=https://api.yoursite.com

# Required for Electron builds: API base URL the desktop app talks to.
# Leave empty for same-origin (Vite proxy in dev), set to full origin in production.
# Do NOT include /api suffix — paths already start with /api/.
# VITE_API_URL_ELECTRON=https://api.yoursite.com


# Optional: DApp URL for frontend applications
# VITE_DAPP_URL=https://dapp.yoursite.com

# Optional: Explicit landing URL for WW-Dash logout redirects.
# Useful when dashboard is served from a different origin/port than landing.
# Examples: http://localhost:5173/ or https://wealthwards.com/
# VITE_LANDING_URL=https://wealthwards.com/

# IMPORTANT REQUIRED FOR ELECTRON: Project ID for Reown AppKit (WalletConnect)
# Get from https://cloud.reown.com/ → Create a new project → copy the Project ID
# Electron MUST use Reown AppKit (NOT the web wagmi injected connector).
# Without this, Electron app will fail to initialize wallet connection.
# Web builds do NOT need this (they use MetaMask injected connector).
VITE_REOWN_PROJECT_ID=

# Optional (Electron): allow insecure cert/CSP relaxations outside dev for troubleshooting only.
# NEVER enable this in production unless strictly temporary.
# ALLOW_INSECURE_ELECTRON=false

# Optional: path for activity log file. Set to empty ("") to log only to console (e.g. on Render free tier).
# ACTIVITY_LOG_PATH=

# Optional: fallback profile store path when MongoDB is unavailable.
# Default: apps/server/.runtime/user-profiles.json
# PROFILE_STORE_PATH=

# Optional: rate-limit tuning (safe defaults are enforced in code if unset)
# Keys are hybrid per IP + authenticated user-subject when available.
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# GLOBAL_RATE_LIMIT_MAX=300
# MUTATION_RATE_LIMIT_WINDOW_MS=60000
# MUTATION_RATE_LIMIT_MAX=120
# INTERNAL_RATE_LIMIT_WINDOW_MS=300000
# INTERNAL_RATE_LIMIT_MAX=120
# EXPENSIVE_READ_LIMIT_WINDOW_MS=60000
# EXPENSIVE_READ_LIMIT_MAX=40

# Optional: Custom RPC URL for fetching wallet balances (defaults to public RPC)
# RPC_URL=https://eth.llamarpc.com

# Alchemy API key for ERC-20 token indexing (used by GET /api/assets)
# Get from https://dashboard.alchemy.com/
# ALCHEMY_API_KEY=

# Etherscan API key for ERC-20 token discovery (used by GET /api/etherscan-assets)
# Get from https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=

# Optional: Google OAuth (for "Login with Google")
# Get from https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID, Web application)
# Authorized redirect URI: https://your-api-host/api/auth/google/callback (or http://localhost:3001/api/auth/google/callback for dev)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional: Facebook OAuth (for "Login with Facebook")
# Get from https://developers.facebook.com/apps (Facebook Login, Web). Redirect URI: https://your-api-host/api/auth/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
