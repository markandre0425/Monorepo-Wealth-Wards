# Copy to ".env" at this repo root (same folder as package.json).
# apps/server loads it via dotenv; Vite apps use envDir ../../ so VITE_* are picked up here too.

# --- Backend (apps/server) — preferred names ---
# Deep API (token discovery, ERC-20 prices). Use Web3 API key or legacy format; server sends X-API-Key or Bearer.
MORALIS_API_KEY=

# Alchemy (token balances / metadata in server discovery paths)
ALCHEMY_API_KEY=

# --- Optional: single set of names ---
# If you only define VITE_* below, the server also reads them (same values in process.env after dotenv).

# --- Browser-exposed (Vite) — required for dashboard client fallbacks in blockchain-api.ts ---
# Moralis Deep Index from the browser (metadata / balance fallbacks). Restrict key by domain in Moralis dashboard.
VITE_MORALIS_API_KEY=

# Alchemy from the browser (dashboard blockchain-api + landing wagmi transports when set)
VITE_ALCHEMY_API_KEY=

# Other Vite vars (examples — see each app for full list)
# VITE_ETHERSCAN_API_KEY=
# VITE_API_URL_WEB=http://localhost:3002
